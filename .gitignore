# Environment files - NEVER commit these
.env
*.env
!.env.example

# Flutter
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/android/local.properties
**/*.iml
**/.idea/

# Supabase local CLI cache
supabase/.temp/

# OS junk
.DS_Store
Thumbs.db

# Environment and secret files
.env
.env.*
!.env.example
**/app.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/key.properties
**/credentials.json
**/service-account*.json

# Flutter generated files
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies
**/.packages

# Node generated files
**/node_modules/

# Local configuration
**/local.properties


# Public Supabase client config required by the current Flutter app
!flutter_app/assets/app.env
