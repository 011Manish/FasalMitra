# FasalMitra Flutter app: files that must never be committed.
# Paths are relative to this folder (flutter_app/).

# Secrets and local settings
*.env
!.env.example
assets/app.env
android/local.properties
key.properties
*.keystore
*.jks
google-services.json

# Flutter and Dart build output
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Local IDE files
*.iml
.idea/
# Public Supabase client config required by the Flutter app
!assets/app.env
